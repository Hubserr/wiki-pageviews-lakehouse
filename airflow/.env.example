AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "login": "<aws-access-key-id>", "password": "<aws-secret-access-key>", "extra": {"region_name": "eu-central-1"}}'
AIRFLOW_CONN_DATABRICKS_DEFAULT='{"conn_type": "databricks", "host": "https://<workspace-host>", "password": "<databricks-token>", "extra": {"http_path": "/sql/1.0/warehouses/<warehouse-id>"}}'
AIRFLOW_VAR_S3_BUCKET=<your-bucket-name>